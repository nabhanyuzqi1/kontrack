rules_version = '2';

// Kontrack — Firestore Security Rules (Fase 1, single-tenant PT PEB)
//
// Sebelumnya berkas ini berakhir dengan
//   match /{document=**} { allow read, write: if signedIn(); }
// sehingga SEMUA blok di atasnya tidak berarti: rules dievaluasi OR, satu
// `allow` yang lolos sudah meloloskan permintaan. Akibatnya user login bisa
// menaikkan `role` miliknya sendiri dan menol kuota AI (`ai_usage`).
// Catch-all itu dihapus total; tiap koleksi didaftarkan eksplisit.
//
// Batasan yang disadari (Fase 2 multi-tenant + custom claims):
// - Peran belum bisa dicek di rules: dokumen `users` di-query lewat field
//   `email`, bukan keyed by uid. Semua user terautentikasi diperlakukan sebagai
//   tim internal; pembedaan peran ditegakkan di Cloud Function.
// - `projects` masih public-read untuk tautan berbagi ke mitra. Semua field
//   proyek ikut terbaca; pengganti yang benar adalah share-token.

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // ---- Koleksi operasional: baca/tulis wajib login -------------------
    // Didaftarkan satu per satu supaya tidak ada koleksi "nyasar" yang
    // tiba-tiba terbuka hanya karena tidak disebut.

    match /transactions/{txnId} {
      allow read, write: if signedIn();
    }

    match /invoices/{invoiceId} {
      allow read, write: if signedIn();
    }

    match /clients/{clientId} {
      allow read, write: if signedIn();
    }

    match /projects/{projectId} {
      // Public-read disengaja: tautan berbagi proyek ke mitra dibuka tanpa
      // login. Transaksi tetap tertutup, jadi mitra tidak melihat biaya.
      allow read: if true;
      allow create, update, delete: if signedIn();
    }

    // ---- Koleksi peka ---------------------------------------------------

    // Profil pengguna. Membaca wajib login (aplikasi mencari peran lewat email).
    // Menulis: HANYA dokumen sendiri, dan hanya field profil.
    //
    // `role` tidak boleh berubah dari klien, tetapi pendaftaran pertama harus
    // boleh membuatnya (dokumen belum ada → request.resource.data.role ==
    // 'staff'). Tanpa pengecualian create ini, signup email/password dan login
    // Google pertama akan gagal.
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'staff';
      allow update: if signedIn()
        && resource.data.email == request.auth.token.email
        && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    // Penghitung kuota AI harian. Kalau klien bisa menulis ke sini, batas
    // harian tinggal dinol-kan sendiri. Hanya Admin SDK (melewati rules).
    match /ai_usage/{docId} {
      allow read, write: if false;
    }

    // Jejak audit — ditulis Cloud Function, tidak boleh disunting klien.
    match /audit_logs/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Pengaturan perusahaan: read publik karena branding/tema dipakai halaman
    // sebelum autentikasi. Tulis wajib login.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if signedIn();
    }

    // ---- Sisanya tertutup ----------------------------------------------
    // Koleksi baru yang belum terdaftar harus ditambahkan eksplisit di atas.
    // Blok ini menutup semuanya, bukan membukanya.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
