# Salin ke .env lalu isi sesuai project Firebase Anda.
VITE_FIREBASE_API_KEY=
# PENTING: samakan dengan domain aplikasi (mis. kontrack.web.app), JANGAN
# <project>.firebaseapp.com — iframe Firebase Auth harus same-origin agar tidak
# diblokir ITP Safari. Firebase Hosting otomatis melayani /__/auth/* di tiap site.
VITE_FIREBASE_AUTH_DOMAIN=kontrack.web.app
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
